
# ActionDoc Agent - Frontend API URL

# 배포된 Cloud Run 백엔드 사용 (기본)
EXPO_PUBLIC_API_URL=https://actiondoc-api-835397104507.asia-northeast3.run.app

# 로컬 FastAPI 백엔드를 사용하는 경우 위 주소 대신 사용
# EXPO_PUBLIC_API_URL=http://localhost:8000

# 모바일 Google 인증: 모두 공개 설정값. 클라이언트 보안 비밀번호/서비스 계정 키를 넣지 않습니다.
# 아래 웹 ID는 actiondoc-agent의 기존 Google 제공업체와 같습니다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=835397104507-b6r56lfq382c3dbihjt5r31o5pehil79.apps.googleusercontent.com
# Firebase iOS 앱의 CLIENT_ID (GoogleService-Info.plist에서 확인)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Firebase 앱 등록 및 OAuth 클라이언트와 정확히 같아야 합니다.
TTOKDOC_ANDROID_PACKAGE=com.actiondoc.ttokdoc
TTOKDOC_IOS_BUNDLE_IDENTIFIER=com.actiondoc.ttokdoc
