# ── LLM ─────────────────────────────────────────────
# mock   : API 키 없이 규칙 기반 추출기로 동작 (개발·테스트용)
# gemini : 실제 Gemini 호출
LLM_PROVIDER=gemini

# (A) Google AI Studio 키로 쓸 때
GEMINI_API_KEY=
# (B) Vertex AI로 쓸 때 (제안서 아키텍처) → USE_VERTEX=true 후 gcloud auth application-default login
USE_VERTEX=false
GCP_PROJECT=actiondoc-agent
GCP_LOCATION=us-central1

GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_RETRIES=1

# ── 저장소 ──────────────────────────────────────────
# memory    : 서버 재시작 시 사라짐 (개발용)
# firestore : 프론트와 같은 Firebase 프로젝트의 Firestore 사용
STORAGE_BACKEND=memory
# firestore 사용 시 서비스 계정 키 경로 (Cloud Run에서는 비워두면 기본 자격증명 사용)
# 키 JSON은 저장소 밖에 보관하고 전체 경로만 설정하세요.
# 예: /Users/your-name/firebase-keys/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# ── 검증 정책 ───────────────────────────────────────
# 최종 신뢰도가 이 값 미만이면 "사용자 확인 필요"
REVIEW_THRESHOLD=80
