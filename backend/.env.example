
# ==================================================
# ActionDoc Agent - Backend Environment Variables
# ==================================================

# 1. LLM 설정
# mock   : API 키 없이 개발 및 테스트
# gemini : 실제 Gemini API를 사용해 문서 분석
LLM_PROVIDER=mock

# Google AI Studio에서 발급받은 API 키
# mock 모드에서는 필요하지 않음
# 실제 API 키는 .env에만 입력하고 Git에 올리지 않기
GEMINI_API_KEY=

# Gemini API 사용 시 false
# Vertex AI를 사용하는 경우 true
USE_VERTEX=false

GCP_PROJECT=actiondoc-agent
GCP_LOCATION=us-central1

# Gemini 모델 설정
GEMINI_MODEL=gemini-3.8-flash

# 필요할 때만 대체 모델 지정 (쉼표로 구분)
GEMINI_FALLBACK_MODELS=

# 일시적인 Gemini API 오류에 대한 재시도 횟수
GEMINI_RETRIES=1


# 2. 데이터 저장 설정
# memory    : 로컬 개발 및 테스트용
# firestore : 실제 Firestore 사용
STORAGE_BACKEND=memory

# 로컬에서 서비스 계정 JSON 키를 사용하는 경우 경로 지정
# Cloud Run에서는 설정하지 않음
GOOGLE_APPLICATION_CREDENTIALS=


# 3. 근거 검증 설정
# 이 점수보다 신뢰도가 낮으면 사용자 확인 필요
REVIEW_THRESHOLD=80

# 4. 시간대
TIMEZONE=Asia/Seoul
